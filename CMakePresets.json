{
    "version": 4,
    "vendor": {
        "conan": {}
    },
    "include": [
        "build/Release/generators/CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Release",
            "description": "Standard Release Build",
            "binaryDir": "${sourceDir}/build/Release",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/Release/generators/conan_toolchain.cmake"
            }
        },
        {
            "name": "asan",
            "displayName": "AddressSanitizer",
            "description": "Build with AddressSanitizer (ASan) memory safety checks",
            "binaryDir": "${sourceDir}/build/asan",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_MAP_IMPORTED_CONFIG_DEBUG": "Release",
                "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/Release/generators/conan_toolchain.cmake"
            }
        },
        {
            "name": "ubsan",
            "displayName": "UndefinedBehaviorSanitizer",
            "description": "Build with UndefinedBehaviorSanitizer (UBSan)",
            "binaryDir": "${sourceDir}/build/ubsan",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_MAP_IMPORTED_CONFIG_DEBUG": "Release",
                "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer -g",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/Release/generators/conan_toolchain.cmake"
            }
        },
        {
            "name": "tsan",
            "displayName": "ThreadSanitizer",
            "description": "Build with ThreadSanitizer (TSan) data race detection",
            "binaryDir": "${sourceDir}/build/tsan",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_MAP_IMPORTED_CONFIG_DEBUG": "Release",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -g",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/Release/generators/conan_toolchain.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan"
        },
        {
            "name": "tsan",
            "configurePreset": "tsan"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
