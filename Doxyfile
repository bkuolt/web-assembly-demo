# Doxyfile for bgl Engine
# Generate locally with: doxygen Doxyfile  (output: build/docs/html/index.html)

PROJECT_NAME           = "bgl Engine"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Modular C++23 WebGPU & glTF 2.0/2.1 3D Graphics Engine"

OUTPUT_DIRECTORY       = build/docs
HTML_OUTPUT            = html
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

# Input Sources & Markdown Guides
INPUT                  = README.md \
                         docs/modules.dox \
                         docs/ARCHITECTURE.md \
                         docs/GETTING_STARTED.md \
                         docs/CHEATSHEET.md \
                         CHANGELOG.md \
                         AGENT_INSTRUCTIONS.md \
                         web/README.md \
                         docs/FEATURE_AND_PHYSICS_REPORT.md \
                         include \
                         src \
                         apps \
                         samples
FILE_PATTERNS          = *.hpp *.cpp *.dox *.md
RECURSIVE              = YES
EXCLUDE                = src/text/EmbeddedFont.cpp \
                         src/gpu/shaders \
                         src/ui/shaders \
                         third_party \
                         build \
                         build-native
IMAGE_PATH             = assets

USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
AUTOLINK_SUPPORT       = YES

# Extraction & Documentation Clarity
EXTENSION_MAPPING      = in=C++
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = src
FULL_PATH_NAMES        = YES

FILTER_PATTERNS        = *.md="python3 scripts/doxygen_md_filter.py"

# Preprocessor Settings
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = __cplusplus=202302L \
                         __has_embed(x)=1 \
                         BGL_ENABLE_PNG=1 \
                         BGL_ENABLE_JPEG=1 \
                         BGL_ENABLE_WEBP=1 \
                         BGL_ENABLE_KTX=1 \
                         BGL_ENABLE_CURL=1 \
                         BGL_ENABLE_AUDIO=1 \
                         BGL_ENABLE_GAMEPAD=1 \
                         BGL_ENABLE_SKYBOX=1

# HTML Appearance & Interactive Navigation
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = TOGGLE
HTML_COPY_CLIPBOARD    = YES
HTML_DYNAMIC_MENUS     = YES
HTML_CODE_FOLDING      = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = HTML-CSS

# Graphviz Architecture & UML Diagrams
HAVE_DOT               = YES
DOT_NUM_THREADS        = 4
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 15
TEMPLATE_RELATIONS     = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0
DOT_MULTI_TARGETS      = YES
GENERATE_LEGEND        = YES

# Diagnostics
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
